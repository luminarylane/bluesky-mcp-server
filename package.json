{
  "name": "@luminarylane/bluesky-mcp-server",
  "version": "1.0.70",
  "description": "Standalone Bluesky MCP Server — SENSE + ACT tools for the AT Protocol",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib/index.js"
  },
  "bin": {
    "luminarylane-bluesky-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "npm test && npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luminarylane/bluesky-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/luminarylane/bluesky-mcp-server/issues"
  },
  "homepage": "https://github.com/luminarylane/bluesky-mcp-server#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "langfuse": "^3.38.20",
    "pino": "^10.3.1",
    "zod": "^4.1.5"
  },
  "overrides": {
    "router": {
      "path-to-regexp": ">=8.4.0"
    },
    "fast-uri": "^4.1.2",
    "ip-address": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
